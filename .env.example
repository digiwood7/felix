# kill switch — PRD §18 R5
#
# maintenance 로 두면 모든 화면이 안내 문구로 대체된다.
# 시각 계산 오류가 실환자에게 1건이라도 발생하면 즉시 켠다.
#
# 비워 두거나 다른 값이면 정상 동작한다.
#
# ⚠ Vercel에서는 환경변수를 바꾼 뒤 재배포해야 반영된다 (약 1분).
#    대시보드에서 Redeploy 버튼으로 트리거한다.
NEXT_PUBLIC_SERVICE_STATUS=


# 익명 이벤트 로그 저장소 — PRD §8 F4 (T11)
#
# 비워 두면 로그는 조용히 버려지고 서비스는 정상 동작한다.
# 로그는 부가 기능이다. 없다고 환자 화면이 멈추지 않는다.
#
# PRD §12 가 지목한 "Vercel KV" 는 2024년 12월에 없어졌다.
# Vercel 은 자체 KV · Postgres 를 접고 Marketplace 연동으로 넘겼고,
# 기존 스토어는 Upstash Redis 로 자동 이관됐다 (2026-08-20 확인).
#
# 붙이는 법
#   Vercel 대시보드 → 프로젝트 → Storage → Marketplace → Upstash for Redis
#   연결하면 아래 값이 자동으로 주입된다. 무료 티어 50만 명령/월.
#
# NEXT_PUBLIC_ 접두사를 붙이지 않는다. 붙이는 순간 토큰이 브라우저
# 번들에 실려 누구나 로그를 읽고 지울 수 있게 된다.
#
# 이름이 두 가지인 이유 — Marketplace 로 붙이면 KV_REST_API_*,
# Upstash 콘솔에서 직접 받으면 UPSTASH_REDIS_REST_* 가 들어온다.
# 코드는 둘 다 읽으므로 들어온 쪽을 그대로 두면 된다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
